# Editor defaults matching what rustfmt and the repo's files already produce,
# so an editor does not fight the formatter on save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces = line break).
[*.md]
trim_trailing_whitespace = false

# Windows shells require CRLF; .gitattributes enforces it on checkout, this
# stops an editor from undoing that on save.
[*.{bat,cmd,ps1}]
end_of_line = crlf
