{
  "RustyTerm": {
    "name": "Rusty Term",
    "description": "Experimental Rust-based terminal emulator",
    "extractDir": "rustyterm",
    "enabled": true,
    "required": false,
    "dependencies": [],
    "releaseSource": {
      "type": "github",
      "repo": "baileyrd/rusty_term",
      "assetPattern": "*win-x64.zip",
      "fallback": {
