{
  "Go": {
    "name": "Go",
    "description": "Statically typed, compiled programming language",
    "provides": [
      "go",
      "gofmt"
    ],
    "extractDir": "go",
    "enabled": true,
    "required": false,
    "dependencies": [],
    "releaseSource": {
      "type": "golang-api",
      "url": "https://go.dev/dl/?mode=json",
      "fallback": {
        "version": "go1.26.6",
        "url": "https://go.dev/dl/go1.26.6.windows-amd64.zip",
        "fileName": "go1.26.6.windows-amd64.zip",
        "size": "~140"
      }
    },
    "postInstallFunction": "Go.PostInstall",
    "pathPriority": 10,
    "pathPrecedence": [
      "%NANER_ROOT%\\vendor\\go\\bin"
    ],
    "environmentVariables": {
      "GOROOT": "%NANER_ROOT%\\vendor\\go",
      "GOPATH": "%NANER_ROOT%\\home\\go",
      "GOCACHE": "%NANER_ROOT%\\home\\.cache\\go-build"
    }
  }
}
