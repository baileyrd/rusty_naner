{
  "PowerShell": {
    "name": "PowerShell",
    "description": "Cross-platform automation and configuration tool",
    "provides": [
      "pwsh"
    ],
    "extractDir": "powershell",
    "enabled": true,
    "required": true,
    "dependencies": [
      "SevenZip"
    ],
    "releaseSource": {
      "type": "github",
      "repo": "PowerShell/PowerShell",
      "assetPattern": "*win-x64.zip",
      "fallback": {
        "version": "v7.6.5",
        "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.6.5/PowerShell-7.6.5-win-x64.zip",
        "fileName": "PowerShell-7.6.5-win-x64.zip",
        "size": "~100"
      }
    },
    "postInstallFunction": "PowerShell.PostInstall",
    "pathPriority": 90,
    "pathPrecedence": [
      "%NANER_ROOT%\\vendor\\powershell"
    ],
    "environmentVariables": {
      "PROFILE": "%NANER_ROOT%\\home\\.config\\powershell\\profile.ps1",
      "PSModulePath": "%NANER_ROOT%\\home\\Documents\\PowerShell\\Modules;%PSModulePath%"
    }
  }
}
