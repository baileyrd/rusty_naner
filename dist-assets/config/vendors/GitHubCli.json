{
  "GitHubCli": {
    "name": "GitHub CLI",
    "description": "Official command-line tool for GitHub",
    "provides": [
      "gh"
    ],
    "extractDir": "gh",
    "enabled": true,
    "required": false,
    "dependencies": [],
    "releaseSource": {
      "type": "github",
      "repo": "cli/cli",
      "assetPattern": "windows_amd64.zip",
      "fallback": {
        "version": "v2.97.0",
        "url": "https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_windows_amd64.zip",
        "fileName": "gh_2.97.0_windows_amd64.zip",
        "size": "~10"
      }
    },
    "pathPriority": 65,
    "pathPrecedence": [
      "%NANER_ROOT%\\vendor\\gh\\bin"
    ]
  }
}
