{
  "Ruby": {
    "name": "Ruby",
    "description": "Dynamic, open source programming language",
    "provides": [
      "ruby",
      "gem",
      "bundle",
      "irb",
      "rake"
    ],
    "extractDir": "ruby",
    "enabled": true,
    "required": false,
    "dependencies": [],
    "releaseSource": {
      "type": "github",
      "repo": "oneclick/rubyinstaller2",
      "assetPattern": "rubyinstaller-*-x64.7z",
      "fallback": {
        "version": "4.0.0-1",
        "url": "https://github.com/oneclick/rubyinstaller2/releases/download/RubyInstaller-4.0.0-1/rubyinstaller-4.0.0-1-x64.7z",
        "fileName": "rubyinstaller-4.0.0-1-x64.7z",
        "size": "~30"
      }
    },
    "postInstallFunction": "Ruby.PostInstall",
    "pathPriority": 30,
    "pathPrecedence": [
      "%NANER_ROOT%\\vendor\\ruby\\bin"
    ],
    "environmentVariables": {
      "GEM_HOME": "%NANER_ROOT%\\home\\.gem",
      "GEM_PATH": "%NANER_ROOT%\\home\\.gem"
    }
  }
}
