{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Naner Configuration",
  "description": "Configuration for Naner terminal launcher",
  "VendorPaths": {
    "Naner": "%NANER_ROOT%\\vendor\\bin\\naner.exe",
    "SevenZip": "%NANER_ROOT%\\vendor\\7zip\\7z.exe",
    "PowerShell": "%NANER_ROOT%\\vendor\\powershell\\pwsh.exe",
    "WindowsTerminal": "%NANER_ROOT%\\vendor\\terminal\\wt.exe",
    "GitBash": "%NANER_ROOT%\\vendor\\git\\bin\\bash.exe",
    "Git": "%NANER_ROOT%\\vendor\\git\\bin\\git.exe",
    "MSYS2Shell": "%NANER_ROOT%\\vendor\\msys64\\msys2_shell.cmd",
    "NodeJS": "%NANER_ROOT%\\vendor\\nodejs\\node.exe",
    "Bun": "%NANER_ROOT%\\vendor\\bun\\bun.exe",
    "Python": "%NANER_ROOT%\\vendor\\anaconda\\python.exe",
    "Conda": "%NANER_ROOT%\\vendor\\anaconda\\Scripts\\conda.exe",
    "Go": "%NANER_ROOT%\\vendor\\go\\bin\\go.exe",
    "Rustc": "%NANER_ROOT%\\vendor\\rust\\.cargo\\bin\\rustc.exe",
    "Cargo": "%NANER_ROOT%\\vendor\\rust\\.cargo\\bin\\cargo.exe",
    "Ruby": "%NANER_ROOT%\\vendor\\ruby\\bin\\ruby.exe",
    "Gem": "%NANER_ROOT%\\vendor\\ruby\\bin\\gem.cmd",
    "DotNet": "%NANER_ROOT%\\vendor\\dotnet-sdk\\dotnet.exe",
    "Uv": "%NANER_ROOT%\\vendor\\uv\\uv.exe",
    "Gh": "%NANER_ROOT%\\vendor\\gh\\bin\\gh.exe",
    "OhMyPosh": "%NANER_ROOT%\\vendor\\oh-my-posh\\oh-my-posh.exe"
  },
  "Environment": {
    "UnifiedPath": true,
    "PathPrecedence": [
      "%NANER_ROOT%\\bin",
      "%NANER_ROOT%\\home\\.npm-global",
      "%NANER_ROOT%\\home\\go\\bin",
      "%NANER_ROOT%\\home\\.cargo\\bin",
      "%NANER_ROOT%\\home\\.gem\\bin",
      "%NANER_ROOT%\\home\\.local\\bin",
      "%NANER_ROOT%\\home\\.local\\Scripts",
      "%NANER_ROOT%\\vendor\\bin",
      // Expands to every installed vendor's own PathPrecedence entries, in
      // pathPriority order -- see config/vendors/. Keeping the marker here
      // rather than appending them is what keeps %NANER_ROOT%\\opt last.
      "%VENDOR_PATHS%",
      "%NANER_ROOT%\\opt"
    ],
    "EnvironmentVariables": {
      "NANER_ROOT": "%NANER_ROOT%",
      "HOME": "%NANER_ROOT%\\home",
      "SSH_HOME": "%NANER_ROOT%\\home\\.ssh",
      // Windows tools mostly ignore HOME and resolve the profile via
      // USERPROFILE/os.homedir() instead, so naner points that at the same
      // place as HOME -- a tool reading ONLY USERPROFILE (os.homedir() on
      // Windows, Python's os.path.expanduser, many Node/Electron/Go tools)
      // now lands inside naner's own tree too, same as everything else
      // here. This only affects processes launched from within a naner
      // shell: their own child processes inherit it, the host is untouched.
      // Any GUI app you run from that shell (naner's own vendored ones
      // included) will see it too, so its own Save/Open dialogs and
      // downloads may default into naner's home rather than the real
      // Windows profile -- an accepted tradeoff for a fully self-contained
      // environment. The XDG trio catches every XDG-aware CLI wholesale;
      // tools with only a private override get one entry each
      // (CLAUDE_CONFIG_DIR here, BUN_INSTALL in Bun's own vendor file).
      "USERPROFILE": "%NANER_ROOT%\\home",
      // Redirected for the same reason as USERPROFILE above: contained
      // within naner rather than mixed into the host's real scratch space.
      // Unlike the XDG trio below, tools are not obligated to create TEMP
      // themselves before using it -- naner creates %NANER_ROOT%\home\.tmp
      // at startup so it's never missing when something needs it.
      "TEMP": "%NANER_ROOT%\\home\\.tmp",
      "TMP": "%NANER_ROOT%\\home\\.tmp",
      "XDG_CONFIG_HOME": "%NANER_ROOT%\\home\\.config",
      "XDG_DATA_HOME": "%NANER_ROOT%\\home\\.local\\share",
      "XDG_CACHE_HOME": "%NANER_ROOT%\\home\\.cache",
      "CLAUDE_CONFIG_DIR": "%NANER_ROOT%\\home\\.claude"
    }
  },
  "DefaultProfile": "Unified",
  "Profiles": {
    "Unified": {
      "Name": "Naner (Unified)",
      "Description": "Unified environment with PowerShell, Git, and Unix tools",
      "Shell": "PowerShell",
      "StartingDirectory": "%USERPROFILE%",
      "Icon": "%NANER_ROOT%\\icons\\naner.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "%NANER_ROOT%\\vendor\\powershell\\pwsh.exe",
        "Arguments": "-NoExit -NoLogo -NoProfile -Command \". '%NANER_ROOT%\\home\\.config\\powershell\\profile.ps1'\""
      }
    },
    "PowerShell": {
      "Name": "PowerShell 7",
      "Description": "PowerShell 7 with vendored tools in PATH",
      "Shell": "PowerShell",
      "StartingDirectory": "%USERPROFILE%",
      "Icon": "%NANER_ROOT%\\icons\\powershell.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "%NANER_ROOT%\\vendor\\powershell\\pwsh.exe",
        "Arguments": "-NoExit -NoLogo -NoProfile -Command \". '%NANER_ROOT%\\home\\.config\\powershell\\profile.ps1'\""
      }
    },
    "Bash": {
      "Name": "Bash",
      "Description": "Git Bash environment",
      "Shell": "Bash",
      "StartingDirectory": "~",
      "Icon": "%NANER_ROOT%\\icons\\bash.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "%NANER_ROOT%\\vendor\\git\\bin\\bash.exe",
        "Arguments": "--login -i"
      }
    },
    "CMD": {
      "Name": "CMD",
      "Description": "Windows Command Prompt with vendored tools",
      "Shell": "CMD",
      "StartingDirectory": "%USERPROFILE%",
      "Icon": "%NANER_ROOT%\\icons\\cmd.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "cmd.exe",
        "Arguments": "/k"
      }
    }
  },
  "WindowsTerminal": {
    "DefaultTerminal": true,
    "LaunchMode": "default",
    "TabTitle": "Naner",
    "SuppressApplicationTitle": true
  },
  "Advanced": {
    "PreservePath": false,
    "InheritSystemPath": true,
    "VerboseLogging": false,
    "DebugMode": false,
    // Testing/dev switch: clears host env vars (other than a small
    // OS-survival allowlist) before naner sets its own, so tools already
    // installed system- or user-wide can't leak into a test run. Off by
    // default; also settable per-invocation with NANER_ISOLATE_ENVIRONMENT=true.
    "IsolateEnvironment": false,
    // Directory junctions created under home\ on first launch after init --
    // bridges specific real Windows locations back out from underneath the
    // USERPROFILE redirect above, without giving up its containment for
    // everything else. %HOST_USERPROFILE% resolves to the real profile
    // directory (captured before naner redirects USERPROFILE); a plain
    // absolute path works too. Skipped, not an error, if the target
    // doesn't exist yet or something's already at the link path.
    "HomeJunctions": {
      "Documents": "%HOST_USERPROFILE%\\Documents",
      "Downloads": "%HOST_USERPROFILE%\\Downloads",
      "Desktop": "%HOST_USERPROFILE%\\Desktop",
      "dev": "C:\\dev"
    }
  },
  "CustomProfiles": {
    // Opt-in examples (comments are stripped by the loader — uncomment to
    // enable). Both need their vendors installed first (`naner install
    // rustyterm` / `naner install rush`).
    // "RustyTerm": {
    //   "Name": "Rusty Term",
    //   "Description": "Experimental rusty_term terminal hosting PowerShell",
    //   "Shell": "PowerShell",
    //   "Terminal": "RustyTerm",
    //   "StartingDirectory": "%USERPROFILE%",
    //   "ColorScheme": "Campbell",
    //   "UseVendorPath": true
    // },
    // "Rush": {
    //   "Name": "Rush",
    //   "Description": "Experimental rush shell in Windows Terminal",
    //   "Shell": "Custom",
    //   "StartingDirectory": "%USERPROFILE%",
    //   "ColorScheme": "Campbell",
    //   "UseVendorPath": true,
    //   "CustomShell": {
    //     "ExecutablePath": "%NANER_ROOT%\\vendor\\rush\\rush.exe"
    //   }
    // }
  }
}