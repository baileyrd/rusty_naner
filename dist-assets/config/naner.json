{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Naner Configuration",
  "description": "Configuration for Naner terminal launcher",
  "VendorPaths": {
    "Naner": "%NANER_ROOT%\\vendor\\bin\\naner.exe",
    "SevenZip": "%NANER_ROOT%\\vendor\\7zip\\7z.exe",
    "PowerShell": "%NANER_ROOT%\\vendor\\powershell\\pwsh.exe",
    "WindowsTerminal": "%NANER_ROOT%\\vendor\\terminal\\wt.exe",
    "GitBash": "%NANER_ROOT%\\vendor\\git\\bin\\bash.exe",
    "Git": "%NANER_ROOT%\\vendor\\git\\bin\\git.exe",
    "MSYS2Shell": "%NANER_ROOT%\\vendor\\msys64\\msys2_shell.cmd",
    "NodeJS": "%NANER_ROOT%\\vendor\\nodejs\\node.exe",
    "Bun": "%NANER_ROOT%\\vendor\\bun\\bun.exe",
    "Python": "%NANER_ROOT%\\vendor\\anaconda\\python.exe",
    "Conda": "%NANER_ROOT%\\vendor\\anaconda\\Scripts\\conda.exe",
    "Go": "%NANER_ROOT%\\vendor\\go\\bin\\go.exe",
    "Rustc": "%NANER_ROOT%\\vendor\\rust\\rustc\\bin\\rustc.exe",
    "Cargo": "%NANER_ROOT%\\vendor\\rust\\cargo\\bin\\cargo.exe",
    "Ruby": "%NANER_ROOT%\\vendor\\ruby\\bin\\ruby.exe",
    "Gem": "%NANER_ROOT%\\vendor\\ruby\\bin\\gem.cmd",
    "DotNet": "%NANER_ROOT%\\vendor\\dotnet-sdk\\dotnet.exe",
    "Uv": "%NANER_ROOT%\\vendor\\uv\\uv.exe"
  },
  "Environment": {
    "UnifiedPath": true,
    "PathPrecedence": [
      "%NANER_ROOT%\\bin",
      "%NANER_ROOT%\\home\\.npm-global",
      "%NANER_ROOT%\\home\\go\\bin",
      "%NANER_ROOT%\\home\\.cargo\\bin",
      "%NANER_ROOT%\\home\\.gem\\bin",
      "%NANER_ROOT%\\home\\.local\\bin",
      "%NANER_ROOT%\\home\\.local\\Scripts",
      "%NANER_ROOT%\\vendor\\bin",
      // Expands to every installed vendor's own PathPrecedence entries, in
      // pathPriority order -- see config/vendors/. Keeping the marker here
      // rather than appending them is what keeps %NANER_ROOT%\\opt last.
      "%VENDOR_PATHS%",
      "%NANER_ROOT%\\opt"
    ],
    "EnvironmentVariables": {
      "NANER_ROOT": "%NANER_ROOT%",
      "HOME": "%NANER_ROOT%\\home",
      "SSH_HOME": "%NANER_ROOT%\\home\\.ssh"
    }
  },
  "DefaultProfile": "Unified",
  "Profiles": {
    "Unified": {
      "Name": "Naner (Unified)",
      "Description": "Unified environment with PowerShell, Git, and Unix tools",
      "Shell": "PowerShell",
      "StartingDirectory": "%USERPROFILE%",
      "Icon": "%NANER_ROOT%\\icons\\naner.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "%NANER_ROOT%\\vendor\\powershell\\pwsh.exe",
        "Arguments": "-NoExit -NoLogo -NoProfile -Command \". '%NANER_ROOT%\\home\\.config\\powershell\\profile.ps1'\""
      }
    },
    "PowerShell": {
      "Name": "PowerShell 7",
      "Description": "PowerShell 7 with vendored tools in PATH",
      "Shell": "PowerShell",
      "StartingDirectory": "%USERPROFILE%",
      "Icon": "%NANER_ROOT%\\icons\\powershell.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "%NANER_ROOT%\\vendor\\powershell\\pwsh.exe",
        "Arguments": "-NoExit -NoLogo -NoProfile -Command \". '%NANER_ROOT%\\home\\.config\\powershell\\profile.ps1'\""
      }
    },
    "Bash": {
      "Name": "Bash",
      "Description": "Git Bash environment",
      "Shell": "Bash",
      "StartingDirectory": "~",
      "Icon": "%NANER_ROOT%\\icons\\bash.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "%NANER_ROOT%\\vendor\\git\\bin\\bash.exe",
        "Arguments": "--login -i"
      }
    },
    "CMD": {
      "Name": "CMD",
      "Description": "Windows Command Prompt with vendored tools",
      "Shell": "CMD",
      "StartingDirectory": "%USERPROFILE%",
      "Icon": "%NANER_ROOT%\\icons\\cmd.ico",
      "ColorScheme": "Campbell",
      "UseVendorPath": true,
      "CustomShell": {
        "ExecutablePath": "cmd.exe",
        "Arguments": "/k"
      }
    }
  },
  "WindowsTerminal": {
    "DefaultTerminal": true,
    "LaunchMode": "default",
    "TabTitle": "Naner",
    "SuppressApplicationTitle": true
  },
  "Advanced": {
    "PreservePath": false,
    "InheritSystemPath": true,
    "VerboseLogging": false,
    "DebugMode": false
  },
  "CustomProfiles": {
    // Opt-in examples (comments are stripped by the loader — uncomment to
    // enable). Both need their vendors enabled in vendors.json first.
    // "RustyTerm": {
    //   "Name": "Rusty Term",
    //   "Description": "Experimental rusty_term terminal hosting PowerShell",
    //   "Shell": "PowerShell",
    //   "Terminal": "RustyTerm",
    //   "StartingDirectory": "%USERPROFILE%",
    //   "ColorScheme": "Campbell",
    //   "UseVendorPath": true
    // },
    // "Rush": {
    //   "Name": "Rush",
    //   "Description": "Experimental rush shell in Windows Terminal",
    //   "Shell": "Custom",
    //   "StartingDirectory": "%USERPROFILE%",
    //   "ColorScheme": "Campbell",
    //   "UseVendorPath": true,
    //   "CustomShell": {
    //     "ExecutablePath": "%NANER_ROOT%\\vendor\\rush\\rush.exe"
    //   }
    // }
  }
}